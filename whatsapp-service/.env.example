# Copie este archivo como whatsapp-service/.env y ajuste los valores.

# Puerto y dirección de escucha. Solo el backend debe llegar a este servicio:
# déjelo en 127.0.0.1 si ambos corren en el mismo equipo.
WHATSAPP_PORT=3100
WHATSAPP_HOST=127.0.0.1

# Token compartido con el backend (el mismo valor que WHATSAPP_SERVICE_TOKEN en backend/.env).
# Obligatorio, mínimo 32 caracteres aleatorios. Genere uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
WHATSAPP_SERVICE_TOKEN=

# Opcional: carpeta donde se guarda la sesión vinculada (por defecto whatsapp-service/.wwebjs_auth).
# WHATSAPP_AUTH_DIR=

# Opcional: ruta del navegador Chrome/Chromium/Edge. Si no se indica, se busca en las rutas habituales.
# CHROME_BIN=
