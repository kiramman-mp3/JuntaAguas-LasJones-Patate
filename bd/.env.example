# Copie este archivo como bd/.env para cambiar las credenciales o el puerto del MySQL de desarrollo.
# Si cambia la contraseña o el puerto, use los mismos valores en backend/.env (DB_PASSWORD, DB_PORT).
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=junta_las_jones
MYSQL_USER=junta_user
MYSQL_PASSWORD=junta_password
# Puerto de este equipo donde se publica MySQL (por ejemplo 3310 si ya usa 3306 otro MySQL).
MYSQL_PUERTO=3306
