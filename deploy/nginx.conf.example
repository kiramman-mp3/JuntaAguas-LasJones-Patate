# HTTPS con Nginx. Copie en /etc/nginx/sites-available/junta, active con un enlace en sites-enabled
# y obtenga el certificado con: sudo certbot --nginx -d agua.ejemplo.ec
# En backend/.env: HOST=127.0.0.1, TRUST_PROXY=1 y FRONTEND_URL=https://agua.ejemplo.ec
server {
    listen 80;
    server_name agua.ejemplo.ec;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name agua.ejemplo.ec;

    # Certbot completa estas rutas.
    ssl_certificate     /etc/letsencrypt/live/agua.ejemplo.ec/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agua.ejemplo.ec/privkey.pem;

    client_max_body_size 12m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
