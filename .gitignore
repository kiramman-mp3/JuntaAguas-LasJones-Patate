# Node dependencies
node_modules/
**/node_modules/

# Environment variables
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example

# Build outputs
dist/
**/dist/
build/
**/build/
out-tsc/

# Angular cache & build
.angular/
**/.angular/

# Uploaded documents & dynamic files
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/documentos/*
!backend/uploads/documentos/.gitkeep
uploads/*
!uploads/.gitkeep

# WhatsApp Web JS auth & cache sessions
# La sesión vinculada equivale a tener el WhatsApp de la Junta abierto: nunca debe versionarse.
# Si se cambia WHATSAPP_AUTH_DIR, use una ruta fuera del repositorio o agréguela aquí.
.wwebjs_auth/
.wwebjs_cache/
**/.wwebjs_auth/
**/.wwebjs_cache/
# Sesiones temporales y respaldos de RemoteAuth (whatsapp-web.js)
**/wwebjs_temp_session*/
**/RemoteAuth*.zip

# Navegadores descargados por Puppeteer y volcados de Chrome
.cache/
**/.cache/
.local-chromium/
**/.local-chromium/
*.dmp

# Test & tooling caches
coverage/
**/coverage/
.nyc_output/
.eslintcache
*.tsbuildinfo
.npm/

# Certificates & database backups (pueden contener secretos o datos personales)
*.pem
*.key
*.p12
*.pfx
*.sql.gz
*.bak
backups/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo

# Temporary files & OS files
.DS_Store
Thumbs.db
desktop.ini
~$*
tmp/
scratch/
scratch_test.js
