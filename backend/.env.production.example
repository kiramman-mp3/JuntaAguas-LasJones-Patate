# Configuración de PRODUCCIÓN. Copie este archivo como backend/.env y complete los valores.
# Luego, desde la raíz del proyecto: npm run prod
NODE_ENV=production
PORT=3000
# Con Nginx/Caddy delante (lo normal en un servidor): 127.0.0.1, para que solo el proxy llegue al puerto.
# 0.0.0.0 expone el puerto en toda la red; úselo solo sin proxy (red local). Ver docs/operacion.md.
HOST=127.0.0.1

# Base de datos MySQL 8. La base se crea vacía si no existe (solo con roles y conceptos de cobro).
# Use un usuario propio con permisos sobre esta base, no root ni las contraseñas de ejemplo.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=junta_app
DB_PASSWORD=
DB_NAME=junta_las_jones

# Secreto para firmar las sesiones. Obligatorio, mínimo 32 caracteres aleatorios.
# Genere uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Primer administrador: se crea solo si la base no tiene ninguno. Recibirá una contraseña
# temporal (se muestra una sola vez al preparar la base) y deberá cambiarla al ingresar.
ADMIN_CEDULA=
ADMIN_NOMBRES=
ADMIN_APELLIDOS=

# Dirección pública del sistema (con HTTPS). El backend sirve el frontend desde el mismo origen, así que
# solo afecta a CORS; aun así déjela correcta.
FRONTEND_URL=https://su-dominio.ec

# Número de proxies delante del backend: 1 detrás de Nginx/Caddy (HTTPS), 0 si se expone directo.
# Con 0 detrás de un proxy, todos los usuarios comparten la IP del proxy: la auditoría registra una IP falsa
# y un usuario puede bloquear las cuentas de otros. Tras desplegar, compruebe en la auditoría que la IP es la real.
TRUST_PROXY=1

# Detalle del registro: debug, info (por defecto), warn, error o silent. En producción es JSON, una línea por evento.
LOG_LEVEL=info

# Servicio de WhatsApp (whatsapp-service/), que publica las convocatorias en el grupo de la Junta.
# WHATSAPP_SERVICE_TOKEN debe ser el mismo valor en whatsapp-service/.env (mínimo 32 caracteres).
# Si se deja vacío, el resto del sistema funciona y solo se deshabilita WhatsApp.
WHATSAPP_SERVICE_URL=http://127.0.0.1:3100
WHATSAPP_SERVICE_TOKEN=
