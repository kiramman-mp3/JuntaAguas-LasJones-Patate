{
  "name": "junta-las-jones-backend",
  "version": "1.0.0",
  "description": "Backend API REST para el Sistema Integrado de Gestión - Junta La Jones",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "init-db": "node src/utils/initDb.js",
    "seed-db": "node src/utils/seedDb.js",
    "seed": "node src/utils/seedDb.js",
