# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development
PORT=3000

# Base de datos (valores del contenedor de bd/docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=junta_las_jones

# Secreto para firmar los JWT. Obligatorio, mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Origen permitido por CORS (URL del frontend)
FRONTEND_URL=http://localhost:4200

# Número de proxies delante del backend (0 en local, 1 detrás de Nginx, etc.)
TRUST_PROXY=0

# Servicio de WhatsApp (whatsapp-service/), que publica las convocatorias en el grupo de la Junta.
# WHATSAPP_SERVICE_TOKEN debe ser el mismo valor en whatsapp-service/.env (mínimo 32 caracteres).
# Si se deja vacío, el resto del sistema funciona y solo se deshabilita WhatsApp.
WHATSAPP_SERVICE_URL=http://127.0.0.1:3100
WHATSAPP_SERVICE_TOKEN=
